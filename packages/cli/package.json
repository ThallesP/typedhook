{
  "name": "typedhook",
  "version": "0.2.0",
  "description": "typedhook CLI: pull typed webhook events from the registry, push yours",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThallesP/typedhook.git",
    "directory": "packages/cli"
  },
  "bin": {
    "typedhook": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "webhooks",
    "typescript",
    "codegen",
    "openapi",
    "standard-webhooks"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean"
  },
  "dependencies": {
    "@typedhook/verify": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
