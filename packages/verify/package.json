{
  "name": "@typedhook/verify",
  "version": "0.1.0",
  "description": "Zero-dependency webhook signature verification (Standard Webhooks / svix compatible) — WebCrypto, runs on Node 20+, Bun, Deno, Workers, edge",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThallesP/typedhook.git",
    "directory": "packages/verify"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./registry": {
      "bun": "./src/cli/registry.ts",
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    }
  },
  "bin": {
    "typedhook": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "webhooks",
    "verify",
    "signature",
    "standard-webhooks",
    "svix",
    "hmac"
  ],
  "scripts": {
    "build": "tsup --entry.index=src/index.ts --entry.registry=src/cli/registry.ts --format esm,cjs --dts --clean && tsup --entry.cli=src/cli/index.ts --format esm"
  },
  "publishConfig": {
    "access": "public"
  }
}
