{
  "name": "@typedhook/sequelize",
  "version": "0.2.0",
  "description": "Sequelize (Postgres, MySQL) outbox adapter for @typedhook/sdk — FOR UPDATE SKIP LOCKED claiming, safe for concurrent workers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThallesP/typedhook.git",
    "directory": "packages/sequelize"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "webhooks",
    "outbox",
    "sequelize",
    "postgres",
    "mysql",
    "adapter"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@typedhook/sdk": "^0.1.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@typedhook/sdk": "workspace:*",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  }
}
