{
  "name": "@typedhook/kysely",
  "version": "0.2.1",
  "description": "Kysely outbox adapter for @typedhook/sdk — Postgres, MySQL and SQLite, safe for concurrent workers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThallesP/typedhook.git",
    "directory": "packages/kysely"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "webhooks",
    "outbox",
    "kysely",
    "postgres",
    "mysql",
    "sqlite",
    "adapter"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@typedhook/sdk": "^0.1.0",
    "kysely": "^0.28.0 || ^0.29.0"
  },
  "devDependencies": {
    "@typedhook/sdk": "workspace:*",
    "@types/pg": "^8.23.1",
    "kysely": "^0.29.6",
    "kysely-bun-sqlite": "^0.4.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  }
}
