{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typedhook-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typedhook-registry",
      // Filled in with `wrangler d1 create typedhook-registry` once deploying; local dev doesn't need it.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The OIDC audience pushes must be minted for: the registry's public URL. Left empty
    // so a deploy without it fails at startup; `bun run dev` passes localhost instead.
    "REGISTRY_URL": ""
  }
}
