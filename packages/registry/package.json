{
  "name": "@typedhook/registry",
  "version": "0.0.0",
  "private": true,
  "description": "Hosted event registry: senders push OpenAPI 3.1 webhook documents, consumers resolve them by semver range",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime=false",
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "jose": "^6.2.12",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/semver": "^7.8.0",
    "wrangler": "^4.149.0"
  }
}
